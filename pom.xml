<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
                             https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>org.jalit</groupId>
    <artifactId>majlis-editions</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>MAJLIS Editions</name>
    <description>MAJLIS Editions</description>
    <url>https://jalit.org/majlis-editions</url>
    <inceptionYear>2024</inceptionYear>

    <organization>
        <name>Institut für den Nahen und Mittleren Osten, Ludwig-Maximilians-Universität München</name>
        <url>https://www.naher-osten.uni-muenchen.de/</url>
    </organization>

    <developers>
        <developer>
            <name>Maximilian de Molière</name>
            <organization>Institut für den Nahen und Mittleren Osten, Ludwig-Maximilians-Universität München</organization>
            <organizationUrl>https://www.naher-osten.uni-muenchen.de/</organizationUrl>
        </developer>
        <developer>
            <name>Adam Retter</name>
            <organization>Evolved Binary</organization>
            <email>adam@evolvedbinary.com</email>
            <organizationUrl>https://www.evolvedbinary.com</organizationUrl>
        </developer>
        <developer>
            <name>Younes Bahloul</name>
            <organization>Evolved Binary</organization>
            <email>younes@evolvedbinary.com</email>
            <organizationUrl>https://www.evolvedbinary.com</organizationUrl>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:https://github.com/jalit-org/majlis-editions.git</connection>
        <developerConnection>scm:git:https://github.com/jalit-org/majlis-editions.git</developerConnection>
        <url>https://github.com/jalit-org/majlis-editions</url>
        <tag>HEAD</tag>
    </scm>

    <licenses>
        <license>
            <name>GNU General Public License, version 3.0 only</name>
            <url>https://opensource.org/licenses/GPL-3.0</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>

        <!-- Elemental / Docker -->
        <elemental.version>6.11.0</elemental.version>
        <elemental.exist-db.expath.pkg.compatible.version>6.4.0</elemental.exist-db.expath.pkg.compatible.version>
        <public.xar.repo.uri>https://exist-db.org/exist/apps/public-repo</public.xar.repo.uri>

        <!-- Dependency XAR versions (must match xar-assembly.xml declarations) -->
        <tei-publisher-lib.xar.version>4.0.4</tei-publisher-lib.xar.version>
        <roaster.xar.version>1.12.1</roaster.xar.version>

        <!-- Docker build output paths -->
        <docker.dir>target/docker</docker.dir>
        <docker.context.dir>target/docker-context</docker.context.dir>

        <!-- EXPath -->
        <package-title>${project.name}</package-title>
        <package-name>https://jalit.org/majlis-editions</package-name>
        <package-abbrev>${project.artifactId}</package-abbrev>
        <package-final-name>${project.artifactId}-${project.version}</package-final-name>

        <!-- node_modules source dirs -->
        <pb.components>node_modules/@teipublisher/pb-components</pb.components>
        <scripts.dir>${pb.components}/dist</scripts.dir>
        <fore.dir>node_modules/@jinntec/fore/dist</fore.dir>
        <fore.resources>node_modules/@jinntec/fore/resources</fore.resources>
        <pb.images>${pb.components}/images</pb.images>
        <pb.css>${pb.components}/css</pb.css>
        <pb.lib>${pb.components}/lib</pb.lib>
        <pb.i18n>${pb.components}/i18n/common</pb.i18n>

    </properties>

    <build>

        <resources>
            <resource>
                <directory>src/main/xar-resources</directory>
                <filtering>false</filtering>
                <targetPath>xar-resources</targetPath>
            </resource>
        </resources>

        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>3.5.0</version>
                </plugin>

                <plugin>
                    <groupId>io.fabric8</groupId>
                    <artifactId>docker-maven-plugin</artifactId>
                    <version>0.48.1</version>
                </plugin>

                <plugin>
                    <groupId>com.github.eirslett</groupId>
                    <artifactId>frontend-maven-plugin</artifactId>
                    <version>1.15.4</version>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <version>3.6.3</version>
                <executions>
                    <execution>
                        <id>enforce-versions</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[11,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9.0,)</version>
                                </requireMavenVersion>
                            </rules>
                            <fail>true</fail>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.evolvedbinary.maven.plugins</groupId>
                <artifactId>buildversion-maven-plugin</artifactId>
                <version>2.0.0</version>
                <executions>
                    <execution>
                        <phase>validate</phase>
                        <goals>
                            <goal>set-properties</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>com.github.eirslett</groupId>
                <artifactId>frontend-maven-plugin</artifactId>
                <configuration>
                    <workingDirectory>${project.basedir}</workingDirectory>
                    <installDirectory>${project.basedir}/.mvn-node</installDirectory>
                    <nodeVersion>v24.11.0</nodeVersion>
                    <npmVersion>11.19.0</npmVersion>
                </configuration>
                <executions>
                    <execution>
                        <id>install-node-and-npm</id>
                        <goals>
                            <goal>install-node-and-npm</goal>
                        </goals>
                        <phase>initialize</phase>
                    </execution>
                    <execution>
                        <id>npm-install</id>
                        <goals>
                            <goal>npm</goal>
                        </goals>
                        <phase>generate-resources</phase>
                        <configuration>
                            <arguments>ci</arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <executions>

                    <execution>
                        <id>copy-xar-resources</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>resources</goal>
                        </goals>
                    </execution>

                    <execution>
                        <id>copy-scripts</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/xar-resources/resources/scripts</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/${scripts.dir}</directory>
                                    <includes>
                                        <include>*.js</include>
                                        <include>*.map</include>
                                    </includes>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/${fore.dir}</directory>
                                    <includes>
                                        <include>*.js</include>
                                        <include>*.map</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <execution>
                        <id>copy-images</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/xar-resources/resources/images</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/${pb.images}</directory>
                                    <includes>
                                        <include>leaflet/*</include>
                                        <include>openseadragon/*</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <execution>
                        <id>copy-css</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/xar-resources/resources/css</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/${pb.css}</directory>
                                </resource>
                                <resource>
                                    <directory>${project.basedir}/${fore.resources}</directory>
                                    <includes>
                                        <include>*.css</include>
                                    </includes>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <execution>
                        <id>copy-lib</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/xar-resources/resources/lib</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/${pb.lib}</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                    <execution>
                        <id>copy-i18n</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>copy-resources</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.outputDirectory}/xar-resources/resources/i18n/common</outputDirectory>
                            <overwrite>true</overwrite>
                            <resources>
                                <resource>
                                    <directory>${project.basedir}/${pb.i18n}</directory>
                                </resource>
                            </resources>
                        </configuration>
                    </execution>

                </executions>
            </plugin>

            <plugin>
                <groupId>ro.kuberam.maven.plugins</groupId>
                <artifactId>kuberam-expath-plugin</artifactId>
                <version>0.6.3</version>
                <executions>
                    <execution>
                        <id>create-xar</id>
                        <phase>package</phase>
                        <goals>
                            <goal>make-xar</goal>
                        </goals>
                        <configuration>
                            <descriptor>xar-assembly.xml</descriptor>
                            <finalName>${package-final-name}</finalName>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-clean-plugin</artifactId>
                <version>3.5.0</version>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <!-- NOTE(AR) Profile to build a Docker Image -->
            <id>docker</id>
            <properties>
                <!-- directory that contains the filtered Dockerfile -->
                <docker.dir>${project.build.directory}/docker</docker.dir>
                <!-- directory for placing files that will be added to the Docker Image -->
                <docker.context.dir>${project.build.directory}/docker-context</docker.context.dir>
            </properties>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-resources-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>process-dockerfile</id>
                                <phase>process-resources</phase>
                                <goals>
                                    <goal>copy-resources</goal>
                                </goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <directory>src/main/docker</directory>
                                            <filtering>true</filtering>
                                        </resource>
                                    </resources>
                                    <outputDirectory>${docker.dir}</outputDirectory>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.evolvedbinary.maven.plugins</groupId>
                        <artifactId>expath-package-repository-plugin</artifactId>
                        <version>1.5.0</version>
                        <executions>
                            <execution>
                                <id>fetch-xars</id>
                                <phase>generate-resources</phase>
                                <goals>
                                    <goal>resolve</goal>
                                </goals>
                                <configuration>
                                    <repoUri>${public.xar.repo.uri}</repoUri>
                                    <outputDirectory>${docker.context.dir}</outputDirectory>
                                    <elementalVersion>${elemental.version}</elementalVersion>
                                    <elementalExistDbPkgCompatibleVersion>${elemental.exist-db.expath.pkg.compatible.version}</elementalExistDbPkgCompatibleVersion>
                                    <packages>
                                        <package>
                                            <abbrev>tei-publisher-lib</abbrev>
                                            <version>${tei-publisher-lib.xar.version}</version>
                                        </package>
                                        <package>
                                            <abbrev>roaster</abbrev>
                                            <version>${roaster.xar.version}</version>
                                        </package>
                                    </packages>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.evolvedbinary.maven.mfrey</groupId>
                        <artifactId>copy-maven-plugin</artifactId>
                        <version>2.1.0</version>
                        <configuration>
                            <showfiles>true</showfiles>
                        </configuration>
                        <executions>
                            <execution>
                                <id>copy-xar-to-docker-context</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>copy</goal>
                                </goals>
                                <configuration>
                                    <resources>
                                        <resource>
                                            <workOnFullPath>true</workOnFullPath>
                                            <directory>${project.build.directory}</directory>
                                            <includes>*.xar</includes>
                                            <paths>
                                                <path>
                                                    <from>${project.build.directory}</from>
                                                    <to>${docker.context.dir}</to>
                                                </path>
                                            </paths>
                                            <replaceExisting>true</replaceExisting>
                                        </resource>
                                    </resources>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <verbose>true</verbose>
                            <images>
                                <image>
                                    <name>majlis-erc/majlis-editions:%v</name>
                                    <alias>majlis-editions</alias>
                                    <registry>ghcr.io</registry>
                                    <build>
                                        <tags>
                                            <tag>latest</tag>
                                        </tags>
                                        <dockerFile>${docker.dir}/Dockerfile</dockerFile>
                                        <contextDir>${docker.context.dir}</contextDir>
                                        <buildx>
                                            <platforms>
                                                <platform>linux/amd64</platform>
                                                <platform>linux/arm64</platform>
                                            </platforms>
                                        </buildx>
                                    </build>
                                </image>
                            </images>
                        </configuration>
                        <executions>
                            <execution>
                                <id>build-image</id>
                                <phase>package</phase>
                                <goals>
                                    <goal>build</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>push-image</id>
                                <phase>deploy</phase>
                                <goals>
                                    <goal>push</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>ci</id>
            <build>
                <plugins>

                    <plugin>
                        <groupId>io.fabric8</groupId>
                        <artifactId>docker-maven-plugin</artifactId>
                        <configuration>
                            <images>
                                <image>
                                    <name>majlis-erc/majlis-editions:%v</name>
                                    <registry>ghcr.io</registry>
                                    <alias>majlis-editions-ci</alias>
                                    <run>
                                        <containerNamePattern>majlis-editions-ci</containerNamePattern>
                                        <ports>
                                            <port>8080:8080</port>
                                        </ports>
                                        <wait>
                                            <http>
                                                <url>http://localhost:8080/exist/apps/majlis-editions</url>
                                                <method>GET</method>
                                                <status>200..399</status>
                                            </http>
                                            <time>120000</time>
                                        </wait>
                                    </run>
                                </image>
                            </images>
                        </configuration>
                        <executions>
                            <execution>
                                <id>ci-docker-start</id>
                                <phase>pre-integration-test</phase>
                                <goals>
                                    <goal>start</goal>
                                </goals>
                            </execution>
                            <execution>
                                <id>ci-docker-stop</id>
                                <phase>post-integration-test</phase>
                                <goals>
                                    <goal>stop</goal>
                                </goals>
                                <configuration>
                                    <allContainers>true</allContainers>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>com.github.eirslett</groupId>
                        <artifactId>frontend-maven-plugin</artifactId>
                        <configuration>
                            <workingDirectory>${project.basedir}</workingDirectory>
                            <installDirectory>${project.basedir}/.mvn-node</installDirectory>
                        </configuration>
                        <executions>
                            <execution>
                                <id>cypress-run</id>
                                <phase>integration-test</phase>
                                <goals>
                                    <goal>npm</goal>
                                </goals>
                                <configuration>
                                    <arguments>run cy:run</arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>

                </plugins>
            </build>
        </profile>
    </profiles>

</project>